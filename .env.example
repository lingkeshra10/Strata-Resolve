# ============================================================
# StrataResolve - Environment Configuration
# ============================================================
# Copy this file to .env and update values for your environment.
# Do NOT commit the .env file to version control.
# ============================================================

# --- Database Configuration ---
POSTGRES_DB=strataresolve
POSTGRES_USER=strataresolve
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# --- Spring Boot ---
SPRING_PROFILES_ACTIVE=dev

# --- JWT Authentication ---
# IMPORTANT: Change this in production! Must be at least 32 characters.
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_TOKEN_EXPIRY=900000
JWT_REFRESH_TOKEN_EXPIRY=604800000

# --- Mail Server ---
# For local development, use MailHog (run with --profile dev)
# For production, configure your SMTP provider (e.g., SendGrid, AWS SES)
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80

# --- Service Ports ---
BACKEND_PORT=8080
FRONTEND_PORT=80

# --- MailHog UI (dev profile only) ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
